@include "header"

<div class="container" style="padding-top: 2.5rem;">
    <div class="card-header-flex" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color);">
        <h1 style="font-size: 1.4rem; font-weight: 800; color: white; display: flex; align-items: center; gap: 0.6rem;">
            <i class="fa-solid fa-boxes-stacked" style="color: var(--accent);"></i>
            Product Management Showcase Table
        </h1>
        <a href="/" class="btn btn-header">
            <i class="fa-solid fa-arrow-left"></i> Back to Home
        </a>
    </div>

    <!-- Query all products -->
    @query products order by id desc
    @endquery

    <div class="step-card" style="padding: 0; overflow: hidden; margin-top: 1.5rem;">
        <table class="doc-table" style="margin: 0; border: none;">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Description</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach products as product
                    <tr>
                        <td style="font-weight: 700; color: var(--text-muted);">#{{ product.id }}</td>
                        <td style="font-weight: 700; color: white;">{{ product.name }}</td>
                        <td><span class="logo-badge" style="background: rgba(6, 182, 212, 0.15); color: var(--accent); shadow: none;">{{ product.category }}</span></td>
                        <td><span style="font-size: 1.1rem; font-weight: 800; color: var(--success);">${{ product.price }}</span></td>
                        <td style="color: var(--text-muted); font-size: 0.92rem;">{{ product.description }}</td>
                        <td style="text-align: right;">
                            <form @delete="products" where="id = {{ product.id }}" redirect="/products">
                                <button type="submit" class="btn" style="background: rgba(239, 68, 68, 0.15); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.4rem 0.9rem; font-size: 0.85rem;">
                                    <i class="fa-solid fa-trash"></i> Delete (@delete)
                                </button>
                            </form>
                        </td>
                    </tr>
                @endforeach
            </tbody>
        </table>
    </div>
</div>

@include "footer"
