@include "header"

<one-container max-width="7xl">
    <div class="py-12 relative z-10">
        <!-- Documentation Header Banner -->
        <div class="mb-14 text-center max-w-4xl mx-auto">
            <one-badge variant="purple">Official Language Specification v0.2</one-badge>
            <div class="mt-4 mb-3">
                <one-heading level="1">OneWeb Enterprise Specification & Developer Guide</one-heading>
            </div>
            <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
                The complete developer reference manual for OneWeb (<code>.one</code>) — covering architecture, directives, validation, authentication, custom developer components, and zero-code database actions.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            <!-- Sidebar Table of Contents Navigation -->
            <div class="lg:col-span-1">
                <div class="glass-card rounded-3xl p-5 sticky top-28 border border-slate-800 shadow-xl space-y-4">
                    <div>
                        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3 px-3">Documentation Index</h4>
                        <nav class="space-y-1 text-xs font-semibold">
                            <a href="#section-1" class="flex items-center gap-2 px-3 py-2 rounded-xl text-indigo-400 bg-indigo-500/10 border border-indigo-500/20">
                                <i class="fa-solid fa-compass text-indigo-400"></i> 1. Overview & Architecture
                            </a>
                            <a href="#section-2" class="flex items-center gap-2 px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">
                                <i class="fa-solid fa-code text-purple-400"></i> 2. Directives Syntax Reference
                            </a>
                            <a href="#section-3" class="flex items-center gap-2 px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">
                                <i class="fa-solid fa-user-lock text-emerald-400"></i> 3. Auth & Authorization
                            </a>
                            <a href="#section-4" class="flex items-center gap-2 px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">
                                <i class="fa-solid fa-paper-plane text-pink-400"></i> 4. Zero-Code Form Validation
                            </a>
                            <a href="#section-5" class="flex items-center gap-2 px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">
                                <i class="fa-solid fa-cubes text-amber-400"></i> 5. Developer Custom Components
                            </a>
                            <a href="#section-6" class="flex items-center gap-2 px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">
                                <i class="fa-solid fa-shield-halved text-rose-400"></i> 6. Security & Performance
                            </a>
                            <a href="#section-7" class="flex items-center gap-2 px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all">
                                <i class="fa-solid fa-laptop-code text-cyan-400"></i> 7. Complete App Examples
                            </a>
                        </nav>
                    </div>

                    <div class="pt-4 border-t border-slate-800/80 text-[11px] text-slate-500 space-y-1.5 px-2">
                        <div class="flex items-center justify-between">
                            <span>Engine Version</span>
                            <span class="text-indigo-400 font-mono font-bold">v0.2 Enterprise</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span>AST Engine Status</span>
                            <span class="text-emerald-400 font-semibold flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span> Active</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Documentation Content -->
            <div class="lg:col-span-3 space-y-12">

                <!-- SECTION 1: Overview & Architecture -->
                <section id="section-1" class="glass-card rounded-3xl p-8 border border-slate-800 shadow-xl space-y-6">
                    <div class="flex items-center gap-3 border-b border-slate-800/80 pb-4">
                        <span class="w-9 h-9 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center font-bold text-base">1</span>
                        <div>
                            <one-heading level="2">Overview & Engine Architecture</one-heading>
                            <p class="text-xs text-slate-400">Understanding OneWeb execution engine and file layout</p>
                        </div>
                    </div>

                    <p class="text-slate-300 text-sm leading-relaxed">
                        <strong>OneWeb</strong> is an HTML-first web programming language and dynamic template engine. Designed with the core philosophy of zero backend boilerplate, OneWeb allows developers to write pure <code>.one</code> template files containing standard HTML5, block directives (<code>&#64;query</code>, <code>&#64;auth</code>, <code>&#64;foreach</code>), and custom engine component tags (<code>&lt;one-card&gt;</code>, <code>&lt;product-card&gt;</code>).
                    </p>

                    <div class="space-y-3">
                        <h4 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-folder-tree text-indigo-400"></i> 1.1 Project Directory Structure
                        </h4>
                        <div class="bg-[#070a12] text-slate-300 rounded-2xl p-5 font-mono text-xs shadow-inner border border-slate-800 leading-relaxed">
                            oneweb/<br>
                            ├── public/ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;-- Developer template files (.one)<br>
                            │ &nbsp;&nbsp;├── index.one &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;-- Home view (http://example.com/)<br>
                            │ &nbsp;&nbsp;├── products.one &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;-- Catalog view (http://example.com/products)<br>
                            │ &nbsp;&nbsp;├── components/ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;-- Custom Developer Components (product-card.one)<br>
                            │ &nbsp;&nbsp;└── includes/ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;-- Reusable template partials (header.one, footer.one)<br>
                            ├── oneweb/engine/ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;-- Core OneWeb Engine (Lexer, Parser, Renderer)<br>
                            └── db.json &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;-- Database configuration file (Optional)
                        </div>
                    </div>
                </section>

                <!-- SECTION 2: Template Directives Syntax Reference -->
                <section id="section-2" class="glass-card rounded-3xl p-8 border border-slate-800 shadow-xl space-y-6">
                    <div class="flex items-center gap-3 border-b border-slate-800/80 pb-4">
                        <span class="w-9 h-9 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold text-base">2</span>
                        <div>
                            <one-heading level="2">Directives Syntax Reference</one-heading>
                            <p class="text-xs text-slate-400">Interpolation, database queries, collection loops, and conditionals</p>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <h4 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-brackets-curly text-indigo-400"></i> 2.1 Variable Interpolation &#123;&#123; ... &#125;&#125;
                        </h4>
                        <p class="text-slate-400 text-xs leading-relaxed">
                            Use double curly braces <code>&#123;&#123; variable &#125;&#125;</code> to evaluate context variables or object dot-notation properties. Output is automatically sanitized against XSS vulnerabilities.
                        </p>
                        <div class="bg-[#070a12] text-slate-300 rounded-2xl p-5 font-mono text-xs shadow-inner border border-slate-800">
                            &lt;h1&gt;Welcome, &#123;&#123; user_name &#125;&#125;!&lt;/h1&gt;<br>
                            &lt;p&gt;Item: &#123;&#123; product.name &#125;&#125; — Price: ৳&#123;&#123; product.price &#125;&#125;&lt;/p&gt;
                        </div>
                    </div>

                    <div class="space-y-3 pt-4 border-t border-slate-800/80">
                        <h4 class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-database text-purple-400"></i> 2.2 Data Fetching Directive (&#64;query)
                        </h4>
                        <div class="bg-[#070a12] text-slate-300 rounded-2xl p-5 font-mono text-xs shadow-inner border border-slate-800">
                            <span class="text-purple-400 font-bold">&#64;query</span> my_products <span class="text-purple-400 font-bold">from</span> products <span class="text-purple-400 font-bold">where</span> price > 500 <span class="text-purple-400 font-bold">order by</span> id <span class="text-purple-400 font-bold">desc</span> <span class="text-purple-400 font-bold">limit</span> 6<br>
                            <span class="text-purple-400 font-bold">&#64;endquery</span>
                        </div>
                    </div>
                </section>

                <!-- SECTION 3: Auth & Authorization Directives -->
                <section id="section-3" class="glass-card rounded-3xl p-8 border border-slate-800 shadow-xl space-y-6">
                    <div class="flex items-center gap-3 border-b border-slate-800/80 pb-4">
                        <span class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-base">3</span>
                        <div>
                            <one-heading level="2">Language-Level Auth & Authorization (&#64;auth / &#64;guest)</one-heading>
                            <p class="text-xs text-slate-400">Conditionally render blocks for logged-in users and guests</p>
                        </div>
                    </div>

                    <p class="text-slate-300 text-sm leading-relaxed">
                        OneWeb includes native authentication directives. Use <code>&#64;auth</code> to display content exclusively to logged-in users and <code>&#64;guest</code> for visitors:
                    </p>

                    <div class="bg-[#070a12] text-slate-300 rounded-2xl p-5 font-mono text-xs shadow-inner border border-slate-800">
                        <span class="text-purple-400 font-bold">&#64;auth</span><br>
                        &nbsp;&nbsp;&lt;<span class="text-amber-400">p</span>&gt;Welcome back, &#123;&#123; auth.user.name &#125;&#125;!&lt;/<span class="text-amber-400">p</span>&gt;<br>
                        &nbsp;&nbsp;&lt;<span class="text-amber-400">one-button</span> <span class="text-indigo-300">href</span>=<span class="text-emerald-300">"/logout"</span> <span class="text-indigo-300">variant</span>=<span class="text-emerald-300">"outline"</span>&gt;Logout&lt;/<span class="text-amber-400">one-button</span>&gt;<br>
                        <span class="text-purple-400 font-bold">&#64;endauth</span><br><br>

                        <span class="text-purple-400 font-bold">&#64;guest</span><br>
                        &nbsp;&nbsp;&lt;<span class="text-amber-400">one-button</span> <span class="text-indigo-300">href</span>=<span class="text-emerald-300">"/login"</span> <span class="text-indigo-300">variant</span>=<span class="text-emerald-300">"primary"</span>&gt;Login to Account&lt;/<span class="text-amber-400">one-button</span>&gt;<br>
                        <span class="text-purple-400 font-bold">&#64;endguest</span>
                    </div>
                </section>

                <!-- SECTION 4: Zero-Code Form Validation -->
                <section id="section-4" class="glass-card rounded-3xl p-8 border border-slate-800 shadow-xl space-y-6">
                    <div class="flex items-center gap-3 border-b border-slate-800/80 pb-4">
                        <span class="w-9 h-9 rounded-xl bg-pink-500/10 text-pink-400 flex items-center justify-center font-bold text-base">4</span>
                        <div>
                            <one-heading level="2">Declarative Form Validation (validate="...")</one-heading>
                            <p class="text-xs text-slate-400">Enforcing input validation rules before database execution</p>
                        </div>
                    </div>

                    <p class="text-slate-300 text-sm leading-relaxed">
                        Annotate forms with <code>validate="field|rule1|rule2;field2|rule"</code>. Supported rules include <code>required</code>, <code>min:N</code>, <code>numeric</code>, and <code>email</code>.
                    </p>

                    <div class="bg-[#070a12] text-slate-300 rounded-2xl p-5 font-mono text-xs shadow-inner border border-slate-800">
                        &lt;<span class="text-rose-400">form</span> <span class="text-purple-400 font-bold">&#64;insert</span>=<span class="text-emerald-300">"products"</span> <span class="text-indigo-300">validate</span>=<span class="text-emerald-300">"name|required|min:3;price|required|numeric"</span> <span class="text-indigo-300">redirect</span>=<span class="text-emerald-300">"/products"</span>&gt;<br>
                        &nbsp;&nbsp;&lt;<span class="text-amber-400">one-input</span> <span class="text-indigo-300">name</span>=<span class="text-emerald-300">"name"</span> <span class="text-indigo-300">label</span>=<span class="text-emerald-300">"Product Name"</span> /&gt;<br>
                        &nbsp;&nbsp;&lt;<span class="text-amber-400">one-input</span> <span class="text-indigo-300">name</span>=<span class="text-emerald-300">"price"</span> <span class="text-indigo-300">label</span>=<span class="text-emerald-300">"Price (৳)"</span> /&gt;<br>
                        &nbsp;&nbsp;&lt;<span class="text-amber-400">one-button</span> <span class="text-indigo-300">type</span>=<span class="text-emerald-300">"submit"</span>&gt;Save Product&lt;/<span class="text-amber-400">one-button</span>&gt;<br>
                        &lt;/<span class="text-rose-400">form</span>&gt;
                    </div>
                </section>

                <!-- SECTION 5: Developer Custom Components -->
                <section id="section-5" class="glass-card rounded-3xl p-8 border border-slate-800 shadow-xl space-y-6">
                    <div class="flex items-center gap-3 border-b border-slate-800/80 pb-4">
                        <span class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-base">5</span>
                        <div>
                            <one-heading level="2">Developer Custom Components (public/components/*.one)</one-heading>
                            <p class="text-xs text-slate-400">Creating custom reusable component tags</p>
                        </div>
                    </div>

                    <p class="text-slate-300 text-sm leading-relaxed">
                        Create custom component files inside <code>public/components/product-card.one</code> and invoke them as custom tags <code>&lt;product-card /&gt;</code> anywhere:
                    </p>

                    <div class="space-y-3">
                        <h4 class="text-xs font-bold text-indigo-400 uppercase tracking-wider">Step A: Create public/components/product-card.one</h4>
                        <div class="bg-[#070a12] text-slate-300 rounded-2xl p-5 font-mono text-xs shadow-inner border border-slate-800">
                            &lt;div class="glass-card p-6 rounded-3xl"&gt;<br>
                            &nbsp;&nbsp;&lt;h3&gt;&#123;&#123; title &#125;&#125;&lt;/h3&gt;<br>
                            &nbsp;&nbsp;&lt;span&gt;৳&#123;&#123; price &#125;&#125;&lt;/span&gt;<br>
                            &nbsp;&nbsp;&lt;div&gt;&#123;&#123; slot &#125;&#125;&lt;/div&gt;<br>
                            &lt;/div&gt;
                        </div>
                    </div>

                    <div class="space-y-3">
                        <h4 class="text-xs font-bold text-purple-400 uppercase tracking-wider">Step B: Use tag in any template</h4>
                        <div class="bg-[#070a12] text-slate-300 rounded-2xl p-5 font-mono text-xs shadow-inner border border-slate-800">
                            &lt;<span class="text-amber-400">product-card</span> <span class="text-indigo-300">title</span>=<span class="text-emerald-300">"Wireless Headphones"</span> <span class="text-indigo-300">price</span>=<span class="text-emerald-300">"3500"</span>&gt;<br>
                            &nbsp;&nbsp;Active Noise Cancelling Headphones.<br>
                            &lt;/<span class="text-amber-400">product-card</span>&gt;
                        </div>
                    </div>
                </section>

                <!-- SECTION 6: Security & Performance -->
                <section id="section-6" class="glass-card rounded-3xl p-8 border border-slate-800 shadow-xl space-y-6">
                    <div class="flex items-center gap-3 border-b border-slate-800/80 pb-4">
                        <span class="w-9 h-9 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center font-bold text-base">6</span>
                        <div>
                            <one-heading level="2">Security Architecture & Performance</one-heading>
                            <p class="text-xs text-slate-400">Built-in protections and AST caching architecture</p>
                        </div>
                    </div>

                    <one-grid cols="2" gap="4">
                        <one-card title="PDO SQL Injection Immunity" badge="Security" badge-variant="success">
                            All <code>&#64;query</code>, <code>&#64;insert</code>, and <code>&#64;update</code> directives use PDO prepared statements with bound parameters, preventing SQL injection attacks completely.
                        </one-card>
                        <one-card title="HMAC SHA-256 CSRF Signatures" badge="Security" badge-variant="purple">
                            Form actions automatically inject HMAC SHA-256 signatures derived from secret engine keys to prevent Cross-Site Request Forgery (CSRF).
                        </one-card>
                    </one-grid>
                </section>

                <!-- SECTION 7: Complete Application Examples -->
                <section id="section-7" class="glass-card rounded-3xl p-8 border border-slate-800 shadow-xl space-y-6">
                    <div class="flex items-center gap-3 border-b border-slate-800/80 pb-4">
                        <span class="w-9 h-9 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold text-base">7</span>
                        <div>
                            <one-heading level="2">Complete Application Code Example</one-heading>
                            <p class="text-xs text-slate-400">Full 1-file production store application written in OneWeb</p>
                        </div>
                    </div>

                    <div class="bg-[#070a12] text-slate-300 rounded-2xl p-6 font-mono text-xs shadow-inner border border-slate-800 leading-relaxed overflow-x-auto">
                        <span class="text-purple-400 font-bold">&#64;include</span> <span class="text-emerald-300">"header"</span><br><br>

                        &lt;<span class="text-amber-400">one-container</span> <span class="text-indigo-300">max-width</span>=<span class="text-emerald-300">"7xl"</span>&gt;<br>
                        &nbsp;&nbsp;&lt;<span class="text-amber-400">one-heading</span> <span class="text-indigo-300">level</span>=<span class="text-emerald-300">"1"</span>&gt;My Store Catalog&lt;/<span class="text-amber-400">one-heading</span>&gt;<br><br>

                        &nbsp;&nbsp;&lt;<span class="text-rose-400">form</span> <span class="text-purple-400 font-bold">&#64;insert</span>=<span class="text-emerald-300">"products"</span> <span class="text-indigo-300">validate</span>=<span class="text-emerald-300">"name|required|min:3;price|required|numeric"</span> <span class="text-indigo-300">redirect</span>=<span class="text-emerald-300">"/products"</span>&gt;<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class="text-amber-400">one-input</span> <span class="text-indigo-300">name</span>=<span class="text-emerald-300">"name"</span> <span class="text-indigo-300">label</span>=<span class="text-emerald-300">"Product Name"</span> <span class="text-indigo-300">required</span> /&gt;<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class="text-amber-400">one-input</span> <span class="text-indigo-300">name</span>=<span class="text-emerald-300">"price"</span> <span class="text-indigo-300">label</span>=<span class="text-emerald-300">"Price (৳)"</span> <span class="text-indigo-300">required</span> /&gt;<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class="text-amber-400">one-button</span> <span class="text-indigo-300">type</span>=<span class="text-emerald-300">"submit"</span>&gt;Add Product&lt;/<span class="text-amber-400">one-button</span>&gt;<br>
                        &nbsp;&nbsp;&lt;/<span class="text-rose-400">form</span>&gt;<br><br>

                        &nbsp;&nbsp;<span class="text-purple-400 font-bold">&#64;query</span> products <span class="text-purple-400 font-bold">from</span> products <span class="text-purple-400 font-bold">order by</span> id <span class="text-purple-400 font-bold">desc</span><br>
                        &nbsp;&nbsp;<span class="text-purple-400 font-bold">&#64;endquery</span><br><br>

                        &nbsp;&nbsp;&lt;<span class="text-amber-400">one-grid</span> <span class="text-indigo-300">cols</span>=<span class="text-emerald-300">"3"</span> <span class="text-indigo-300">gap</span>=<span class="text-emerald-300">"6"</span>&gt;<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-purple-400 font-bold">&#64;foreach</span> products <span class="text-purple-400 font-bold">as</span> product<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class="text-amber-400">product-card</span> <span class="text-indigo-300">id</span>=<span class="text-emerald-300">"&#123;&#123; product.id &#125;&#125;"</span> <span class="text-indigo-300">title</span>=<span class="text-emerald-300">"&#123;&#123; product.name &#125;&#125;"</span> <span class="text-indigo-300">price</span>=<span class="text-emerald-300">"&#123;&#123; product.price &#125;&#125;"</span>&gt;<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class="text-rose-400">form</span> <span class="text-purple-400 font-bold">&#64;delete</span>=<span class="text-emerald-300">"products"</span> <span class="text-indigo-300">where</span>=<span class="text-emerald-300">"id = &#123;&#123; product.id &#125;&#125;"</span> <span class="text-indigo-300">redirect</span>=<span class="text-emerald-300">"/products"</span>&gt;<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class="text-amber-400">one-button</span> <span class="text-indigo-300">type</span>=<span class="text-emerald-300">"submit"</span> <span class="text-indigo-300">variant</span>=<span class="text-emerald-300">"danger"</span>&gt;Delete&lt;/<span class="text-amber-400">one-button</span>&gt;<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;/<span class="text-rose-400">form</span>&gt;<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;/<span class="text-amber-400">product-card</span>&gt;<br>
                        &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-purple-400 font-bold">&#64;endforeach</span><br>
                        &nbsp;&nbsp;&lt;/<span class="text-amber-400">one-grid</span>&gt;<br>
                        &lt;/<span class="text-amber-400">one-container</span>&gt;<br><br>

                        <span class="text-purple-400 font-bold">&#64;include</span> <span class="text-emerald-300">"footer"</span>
                    </div>
                </section>

            </div>
        </div>
    </div>
</one-container>

@include "footer"
