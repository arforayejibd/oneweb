@include "header"

<one-container max-width="7xl">
    <!-- Hero Section -->
    <div class="py-20 sm:py-28 text-center relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 backdrop-blur-md mb-8">
            <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">HTML-First Web Programming Language Engine</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-[1.15] mb-6">
            Build Dynamic Database Apps <br class="hidden sm:inline">
            <span class="text-gradient-primary">Directly Inside Pure HTML</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
            OneScript empowers developers to query databases, handle form submissions, and construct dynamic web applications using simple <strong>.one</strong> files without writing complex backend boilerplate code.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
            <one-button href="/tutorial" variant="primary">
                <i class="fa-solid fa-graduation-cap mr-1"></i> Start Tutorial (15 Min)
            </one-button>
            <one-button href="/docs" variant="outline">
                <i class="fa-solid fa-book-open mr-1"></i> Documentation
            </one-button>
            <one-button href="/products" variant="secondary">
                <i class="fa-solid fa-laptop-code mr-1"></i> Live Showcase App
            </one-button>
        </div>

        <!-- Live Engine Performance Metric Pill Bar -->
        <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-4xl mx-auto p-4 rounded-3xl glass-card border border-slate-800/80">
            <div class="text-center p-3">
                <div class="text-2xl font-extrabold text-white">1.2ms</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">AST Render Speed</div>
            </div>
            <div class="text-center p-3 border-l border-slate-800/80">
                <div class="text-2xl font-extrabold text-indigo-400">100%</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">HTML-First Syntax</div>
            </div>
            <div class="text-center p-3 border-l border-slate-800/80">
                <div class="text-2xl font-extrabold text-purple-400">PDO</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">MySQL & SQLite</div>
            </div>
            <div class="text-center p-3 border-l border-slate-800/80">
                <div class="text-2xl font-extrabold text-emerald-400">Zero</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-1">Backend Boilerplate</div>
            </div>
        </div>
    </div>

    <!-- Core Engine Capabilities Grid -->
    <div class="py-16 border-t border-slate-800/80">
        <div class="text-center max-w-2xl mx-auto mb-14">
            <one-badge variant="info">Built-in UI Component System</one-badge>
            <div class="mt-4 mb-3">
                <one-heading level="2">OneScript Language Capabilities</one-heading>
            </div>
            <p class="text-slate-400 text-sm">Empowering developers with unified directive tags and engine-driven component rendering</p>
        </div>

        <one-grid cols="3" gap="6">
            <one-card title="100% HTML-First" badge="Core Feature" badge-variant="info">
                Build dynamic web applications using the HTML knowledge you already have. No complex backend routing or boilerplate code required.
            </one-card>

            <one-card title="Declarative Directives" badge="Syntax" badge-variant="purple">
                Use simple directives like <code>@query</code>, <code>@foreach</code>, and <code>@if</code> directly in your HTML templates.
            </one-card>

            <one-card title="Architectural Security" badge="Security" badge-variant="success">
                Built-in parameterized SQL query execution to eliminate SQL Injection, and default HTML escaping for XSS protection.
            </one-card>

            <one-card title="Lightning Fast (AST Caching)" badge="Performance" badge-variant="warning">
                Compiled AST template caching renders <strong>.one</strong> templates in 1-2 milliseconds with static HTML performance.
            </one-card>

            <one-card title="cPanel & Shared Hosting Ready" badge="Deployment" badge-variant="info">
                Deploy instantly to any $1 shared hosting or cPanel account without requiring dedicated VPS or Docker setup.
            </one-card>

            <one-card title="Zero Code Form Actions" badge="Forms" badge-variant="danger">
                Specify <code>@insert</code>, <code>@update</code>, or <code>@delete</code> directly on HTML form tags with automatic CSRF & validation.
            </one-card>
        </one-grid>
    </div>

    <!-- Interactive Code Window Showcase -->
    <div class="py-16 border-t border-slate-800/80">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <one-badge variant="purple">Clean Directive Grammar</one-badge>
            <div class="mt-4 mb-3">
                <one-heading level="2">Readable, Declarative Syntax</one-heading>
            </div>
            <p class="text-slate-400 text-sm">Fetch database records and process user input directly in HTML:</p>
        </div>

        <div class="glass-card rounded-3xl overflow-hidden shadow-2xl border border-slate-800">
            <!-- Window Control Header -->
            <div class="bg-slate-900/90 px-6 py-4 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
                    <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
                    <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
                    <span class="ml-4 text-xs font-mono text-slate-400">public/index.one</span>
                </div>
                <span class="text-xs font-mono text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">OneScript Syntax</span>
            </div>

            <!-- Code Content -->
            <div class="p-6 sm:p-8 font-mono text-xs sm:text-sm text-slate-300 leading-relaxed overflow-x-auto bg-[#070a12]">
                <span class="text-slate-500">&lt;!-- 1. Database Fetch &amp; Loop --&gt;</span><br>
                <span class="text-purple-400 font-bold">@query</span> products <span class="text-purple-400 font-bold">from</span> products <span class="text-purple-400 font-bold">order by</span> id <span class="text-purple-400 font-bold">desc</span><br>
                <span class="text-purple-400 font-bold">@endquery</span><br><br>

                <span class="text-purple-400 font-bold">@foreach</span> products <span class="text-purple-400 font-bold">as</span> product<br>
                &nbsp;&nbsp;&lt;<span class="text-amber-400">one-card</span> <span class="text-indigo-300">title</span>=<span class="text-emerald-300">"{{ product.name }}"</span> <span class="text-indigo-300">price</span>=<span class="text-emerald-300">"৳{{ product.price }}"</span>&gt;<br>
                &nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class="text-amber-400">p</span>&gt;{{ product.description }}&lt;/<span class="text-amber-400">p</span>&gt;<br>
                &nbsp;&nbsp;&lt;/<span class="text-amber-400">one-card</span>&gt;<br>
                <span class="text-purple-400 font-bold">@endforeach</span><br><br>

                <span class="text-slate-500">&lt;!-- 2. Declarative Zero-Backend Form Save --&gt;</span><br>
                &lt;<span class="text-rose-400">form</span> <span class="text-purple-400 font-bold">@insert</span>=<span class="text-emerald-300">"contacts"</span> <span class="text-indigo-300">redirect</span>=<span class="text-emerald-300">"/"</span>&gt;<br>
                &nbsp;&nbsp;&lt;<span class="text-amber-400">one-input</span> <span class="text-indigo-300">name</span>=<span class="text-emerald-300">"name"</span> <span class="text-indigo-300">label</span>=<span class="text-emerald-300">"Your Name"</span> /&gt;<br>
                &nbsp;&nbsp;&lt;<span class="text-amber-400">one-button</span> <span class="text-indigo-300">type</span>=<span class="text-emerald-300">"submit"</span>&gt;Save Message&lt;/<span class="text-amber-400">one-button</span>&gt;<br>
                &lt;/<span class="text-rose-400">form</span>&gt;
            </div>
        </div>
    </div>

    <!-- Community Feedback Form using OneScript @insert -->
    <div class="py-16 border-t border-slate-800/80">
        <div class="glass-card rounded-3xl p-8 sm:p-10 border border-slate-800 shadow-2xl">
            <div class="max-w-2xl mb-8">
                <one-heading level="2">Submit Feedback or Message (@insert)</one-heading>
                <p class="text-slate-400 text-sm">Form submission handles CSRF protection, mass assignment, and SQLite/MySQL save automatically without writing backend PHP handlers.</p>
            </div>

            <form @insert="contacts" redirect="/">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <one-input name="name" label="Your Name" placeholder="Enter your name" required />
                    <one-input name="email" type="email" label="Email Address" placeholder="name@example.com" required />
                </div>
                <one-input name="message" label="Message or Inquiry" placeholder="Write your message..." required />
                
                <div class="mt-4">
                    <one-button type="submit" variant="primary">
                        <i class="fa-solid fa-paper-plane mr-1"></i> Submit Message (@insert)
                    </one-button>
                </div>
            </form>
        </div>
    </div>

    <!-- Community Messages Section using OneScript @query & @foreach -->
    <div class="py-16 border-t border-slate-800/80">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
            <div>
                <one-heading level="3">Recent Messages Received (@query contacts)</one-heading>
                <p class="text-slate-400 text-sm">Live data loaded directly from database via OneScript engine</p>
            </div>
            <one-badge variant="success">Live Database Feed</one-badge>
        </div>

        @query contacts from contacts order by id desc limit 6
        @endquery

        <one-grid cols="3" gap="6">
            @foreach contacts as contact
                <one-card title="{{ contact.name }}" badge="{{ contact.email }}" badge-variant="info">
                    <p>{{ contact.message }}</p>
                </one-card>
            @endforeach
        </one-grid>
    </div>
</one-container>

@include "footer"