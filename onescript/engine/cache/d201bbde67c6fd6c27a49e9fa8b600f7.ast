    <main class="main-content">

        <!-- Banner Header -->
        <div class="docs-banner">
            <h1 class="doc-title">OneScript Documentation</h1>
            <p class="doc-subtitle">Official developer guide and complete syntax specification for building server-side HTML-first web applications.</p>
        </div>

        <!-- Chapter 1: Intro -->
        <section id="intro" class="doc-section">
            <h2 class="section-title">
                <div class="title-icon"><i class="fa-solid fa-rocket"></i></div>
                1. Introduction & Core Philosophy
            </h2>
            <p><strong>OneScript</strong> is a server-side HTML-first programming language designed to eliminate backend boilerplate. Operations like querying databases, saving form submissions, rendering loops, and enforcing security occur directly inside HTML using intuitive directives.</p>

            <div class="callout">
                <div class="callout-title"><i class="fa-solid fa-lightbulb" style="color: var(--warning);"></i> Core Philosophy</div>
                <p style="margin-bottom: 0;">HTML should remain HTML. OneScript makes HTML dynamic—it does not replace HTML with a complex foreign framework syntax.</p>
            </div>
        </section>

        <!-- Chapter 2: Quick Start -->
        <section id="quickstart" class="doc-section">
            <h2 class="section-title">
                <div class="title-icon"><i class="fa-solid fa-bolt"></i></div>
                2. Quick Start Guide
            </h2>
            <p>Follow these 3 steps to create your first dynamic web application:</p>

            <div class="step-card">
                <div class="step-header">
                    <div class="step-number">1</div>
                    <h3 style="margin:0;">Create file inside `public/` directory</h3>
                </div>
                <p style="margin-bottom: 0;">Create your template at <strong>`public/index.one`</strong>.</p>
            </div>

            <div class="step-card">
                <div class="step-header">
                    <div class="step-number">2</div>
                    <h3 style="margin:0;">Configure Database (`config.one`)</h3>
                </div>
                <p style="margin-bottom: 0.5rem;">Set your database connection in <code>config.one</code>:</p>
                
                <div class="code-window">
                    <div class="code-header">
                        <div class="code-dots"><div class="dot dot-red"></div><div class="dot dot-yellow"></div><div class="dot dot-green"></div></div>
                        <div class="code-filename">config.one</div>
                    </div>
                    <div class="code-block">
<span class="code-directive">@db</span>
driver = <span class="code-val">"mysql"</span>
host = <span class="code-val">"127.0.0.1"</span>
dbname = <span class="code-val">"mywebsite"</span>
username = <span class="code-val">"root"</span>
password = <span class="code-val">"secret"</span>
<span class="code-directive">@enddb</span>
                    </div>
                </div>
            </div>

            <div class="step-card">
                <div class="step-header">
                    <div class="step-number">3</div>
                    <h3 style="margin:0;">Write HTML with OneScript Directives</h3>
                </div>
                
                <div class="code-window">
                    <div class="code-header">
                        <div class="code-dots"><div class="dot dot-red"></div><div class="dot dot-yellow"></div><div class="dot dot-green"></div></div>
                        <div class="code-filename">public/index.one</div>
                    </div>
                    <div class="code-block">
<span class="code-comment">&lt;!-- 1. Data Query & Loop --&gt;</span>
<span class="code-directive">@query</span> products <span class="code-directive">from</span> products <span class="code-directive">order by</span> id <span class="code-directive">desc</span>
<span class="code-directive">@endquery</span>

<span class="code-directive">@foreach</span> products <span class="code-directive">as</span> product
&lt;<span class="code-tag">div</span> <span class="code-attr">class</span>=<span class="code-val">"card"</span>&gt;
    &lt;<span class="code-tag">h3</span>&gt;";}i:2;a:2:{s:4:"type";s:7:"VarNode";s:10:"expression";s:12:"product.name";}i:3;a:2:{s:4:"type";s:8:"TextNode";s:5:"value";s:94:"&lt;/<span class="code-tag">h3</span>&gt;
