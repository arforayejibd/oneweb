        <!-- Chapter 7: Form Actions -->
        <section id="forms" class="doc-section">
            <h2 class="section-title">
                <div class="title-icon"><i class="fa-solid fa-paper-plane"></i></div>
                7. Declarative Form Actions (@insert & @delete)
            </h2>
            <p>Process database inserts and deletions declaratively on HTML form tags without writing any backend PHP or SQL scripts:</p>

