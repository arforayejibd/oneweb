        <!-- Chapter 5: Query Directive -->
        <section id="query" class="doc-section">
            <h2 class="section-title">
                <div class="title-icon"><i class="fa-solid fa-database"></i></div>
                5. Database Fetch Directive (@query)
            </h2>
            <p>Fetch records from database tables cleanly using <code>@query</code>:</p>

            <table class="doc-table">
                <thead>
                    <tr>
                        <th>Clause</th>
                        <th>Description & Example Syntax</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>from &lt;table&gt;</code></td>
                        <td>Specifies the database table name (e.g. <code>from products</code>)</td>
                    </tr>
                    <tr>
                        <td><code>where &lt;cond&gt;</code></td>
                        <td>Filters records safely via PDO binding (e.g. <code>where category = "Electronics"</code>)</td>
                    </tr>
                    <tr>
                        <td><code>order by &lt;col&gt;</code></td>
                        <td>Orders records (e.g. <code>order by id desc</code>)</td>
                    </tr>
                    <tr>
                        <td><code>limit &lt;N&gt;</code></td>
                        <td>Limits maximum records returned (e.g. <code>limit 10</code>)</td>
                    </tr>
                    <tr>
                        <td><code>first</code></td>
                        <td>Fetches a single single record object instead of an array</td>
                    </tr>
                </tbody>
            </table>

            <div class="code-window">
                <div class="code-header">
                    <div class="code-dots"><div class="dot dot-red"></div><div class="dot dot-yellow"></div><div class="dot dot-green"></div></div>
                    <div class="code-filename">Query Directives</div>
                </div>
                <div class="code-block">
<span class="code-comment">&lt;!-- Query Multiple Array Records --&gt;</span>
<span class="code-directive">@query</span> products <span class="code-directive">from</span> products <span class="code-directive">where</span> status = <span class="code-val">"active"</span> <span class="code-directive">order by</span> id <span class="code-directive">desc</span> <span class="code-directive">limit</span> 6
<span class="code-directive">@endquery</span>

<span class="code-comment">&lt;!-- Query Single Record --&gt;</span>
<span class="code-directive">@query</span> product <span class="code-directive">from</span> products <span class="code-directive">where</span> id = <span class="code-val">5</span> <span class="code-directive">first</span>
<span class="code-directive">@endquery</span>

&lt;<span class="code-tag">h1</span>&gt;";}i:14;a:2:{s:4:"type";s:7:"VarNode";s:10:"expression";s:12:"product.name";}i:15;a:2:{s:4:"type";s:8:"TextNode";s:5:"value";s:1116:"&lt;/<span class="code-tag">h1</span>&gt;
