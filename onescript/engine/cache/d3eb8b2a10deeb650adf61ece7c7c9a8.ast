    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-badge">
            <i class="fa-solid fa-wand-magic-sparkles" style="color: var(--accent);"></i>
            HTML-First Web Programming Language
        </div>
        
        <h1 class="hero-title">
            Build Dynamic Database Apps Directly Inside HTML
        </h1>

        <p class="hero-subtitle">
            OneScript empowers developers to query databases, handle form submissions, and construct dynamic web applications using simple <strong>.one</strong> files without writing complex backend boilerplate code.
        </p>

        <div class="hero-buttons">
            <a href="/docs" class="btn btn-primary">
                <i class="fa-solid fa-book-open"></i> Read Documentation
            </a>
            <a href="/products" class="btn btn-secondary">
                <i class="fa-solid fa-laptop-code"></i> Live Showcase App
            </a>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <div class="section-header">
            <h2>Why Choose OneScript?</h2>
            <p style="color: var(--text-muted);">Engineered for developer simplicity, architectural security, and static HTML speed.</p>
        </div>

        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon"><i class="fa-solid fa-code"></i></div>
                <h3>100% HTML-First</h3>
                <p>Build dynamic sites using the HTML knowledge you already have. No complex backend frameworks to master.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <h3>Architectural Security</h3>
                <p>Built-in parameterized SQL query execution to eliminate SQL Injection, and default HTML escaping for XSS protection.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon"><i class="fa-solid fa-bolt"></i></div>
                <h3>Lightning Fast (AST Caching)</h3>
                <p>Compiled AST template caching renders <strong>.one</strong> templates in 1-2 milliseconds with static HTML performance.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon"><i class="fa-solid fa-server"></i></div>
                <h3>cPanel & Shared Hosting Ready</h3>
                <p>Deploy instantly to any $1 shared hosting or cPanel account without requiring dedicated VPS or Docker setup.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon"><i class="fa-solid fa-database"></i></div>
                <h3>MySQL & SQLite Engine</h3>
                <p>Seamless PDO database abstraction supporting MySQL, MariaDB, and zero-config SQLite out of the box.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon"><i class="fa-solid fa-paper-plane"></i></div>
                <h3>Declarative Form Actions</h3>
                <p>Specify <code>@insert</code> or <code>@delete</code> directly on HTML form tags to process database requests with zero code.</p>
            </div>
        </div>
    </section>

