<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct HTTP access to raw .one, .json, .sqlite, and config files
    <FilesMatch "\.(one|json|sqlite|db|env)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Route all HTTP requests to public/ or engine/boot.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ oneweb/engine/boot.php [QSA,L]
</IfModule>
