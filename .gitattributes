# Auto detect text files and perform LF normalization
* text=auto

# ------------------------------------------------------------------
# GitHub Linguist Custom Language Override Settings
# ------------------------------------------------------------------

# 1. Classify .one files strictly as OneScript language
*.one linguist-language=OneScript
*.one linguist-detectable=true

# 2. Treat core PHP engine files as internal framework vendor code
onescript/** linguist-vendored
tests/** linguist-vendored
