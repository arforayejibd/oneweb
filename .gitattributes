# Auto detect text files and perform LF normalization
* text=auto

# ------------------------------------------------------------------
# GitHub Linguist Language Override Settings
# ------------------------------------------------------------------

# 1. Treat .one template files as the main language/markup of the repository
*.one linguist-language=HTML
*.one linguist-detectable=true

# 2. Exclude CSS assets, core PHP engine, and test files from language statistics
public/css/** linguist-vendored
onescript/** linguist-vendored
tests/** linguist-vendored
