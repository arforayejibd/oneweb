#!/usr/bin/env php
<?php

/**
 * OneScript Local Development Server Runner & Initializer
 */

if (PHP_SAPI !== 'cli') {
    exit("This script can only be run from the command line.\n");
}

$projectRoot = getcwd();
$packageRoot = dirname(__DIR__);
$bootScript = $packageRoot . '/onescript/engine/boot.php';

// Fallback if directory structure is different
if (!file_exists($bootScript)) {
    $bootScript = $projectRoot . '/vendor/arforayejibd/oneweb/onescript/engine/boot.php';
}

if ($argc > 1 && $argv[1] === 'update') {
    echo "=== OneWeb Auto-Updater ===\n";
    $currentVersion = 'v1.0.4';
    echo "Current Version: $currentVersion\n";
    echo "Checking for latest release on GitHub...\n";
    
    $opts = [
        'http' => [
            'method' => 'GET',
            'header' => [
                'User-Agent: OneWeb-Updater'
            ]
        ]
    ];
    $context = stream_context_create($opts);
    $apiUrl = 'https://api.github.com/repos/arforayejibd/oneweb/releases/latest';
    $response = @file_get_contents($apiUrl, false, $context);
    
    if (!$response) {
        echo "Error: Could not connect to GitHub API to check for updates.\n";
        exit(1);
    }
    
    $release = json_decode($response, true);
    $latestVersion = $release['tag_name'] ?? null;
    $zipUrl = $release['zipball_url'] ?? null;
    
    if (!$latestVersion || !$zipUrl) {
        echo "Error: Failed to parse latest release data from GitHub.\n";
        exit(1);
    }
    
    echo "Latest Available Version: $latestVersion\n";
    
    if (version_compare(ltrim($latestVersion, 'v'), ltrim($currentVersion, 'v'), '<=')) {
        echo "You are already up to date!\n";
        exit(0);
    }
    
    echo "New version found! Downloading update package...\n";
    $tempZip = sys_get_temp_dir() . DIRECTORY_SEPARATOR . 'oneweb_update_' . uniqid() . '.zip';
    
    $zipContent = @file_get_contents($zipUrl, false, $context);
    if (!$zipContent) {
        echo "Error: Failed to download update package zip.\n";
        exit(1);
    }
    
    if (@file_put_contents($tempZip, $zipContent) === false) {
        echo "Error: Failed to save temporary update file.\n";
        exit(1);
    }
    
    echo "Extracting files...\n";
    if (!class_exists('ZipArchive')) {
        echo "Error: ZipArchive extension is not enabled in your PHP installation. Please update manually.\n";
        @unlink($tempZip);
        exit(1);
    }
    
    $zip = new ZipArchive;
    if ($zip->open($tempZip) === TRUE) {
        $tempExtractDir = sys_get_temp_dir() . DIRECTORY_SEPARATOR . 'oneweb_extracted_' . uniqid();
        @mkdir($tempExtractDir, 0777, true);
        $zip->extractTo($tempExtractDir);
        $zip->close();
        
        $dirs = glob($tempExtractDir . DIRECTORY_SEPARATOR . '*', GLOB_ONLYDIR);
        if (empty($dirs)) {
            echo "Error: Failed to locate extracted update directory.\n";
            @unlink($tempZip);
            exit(1);
        }
        $extractedRoot = $dirs[0];
        
        echo "Applying updates to engine components...\n";
        
        $copyDir = function($src, $dst) use (&$copyDir) {
            if (!is_dir($dst)) {
                @mkdir($dst, 0777, true);
            }
            $dir = opendir($src);
            while (false !== ($file = readdir($dir))) {
                if (($file != '.') && ($file != '..')) {
                    if (is_dir($src . '/' . $file)) {
                        $copyDir($src . '/' . $file, $dst . '/' . $file);
                    } else {
                        @copy($src . '/' . $file, $dst . '/' . $file);
                    }
                }
            }
            closedir($dir);
        };
        
        // 1. Copy onescript/engine/ directory
        $srcEngine = $extractedRoot . '/onescript/engine';
        $dstEngine = $projectRoot . '/onescript/engine';
        if (is_dir($srcEngine)) {
            $copyDir($srcEngine, $dstEngine);
            echo " - Updated core engine files.\n";
        }
        
        // 2. Copy bin/onescript script
        $srcBin = $extractedRoot . '/bin/onescript';
        $dstBin = $projectRoot . '/bin/onescript';
        if (file_exists($srcBin)) {
            @copy($srcBin, $dstBin);
            echo " - Updated runner script.\n";
        }
        
        // 3. Copy shortcuts in project root
        $shortcuts = ['one', 'one.bat', 'run', 'run.bat', 'start', 'start.bat'];
        foreach ($shortcuts as $sc) {
            $srcSc = $extractedRoot . '/' . $sc;
            $dstSc = $projectRoot . '/' . $sc;
            if (file_exists($srcSc)) {
                @copy($srcSc, $dstSc);
            }
        }
        echo " - Updated shortcut scripts.\n";
        
        // Clean up
        $removeDir = function($dir) use (&$removeDir) {
            if (is_dir($dir)) {
                $objects = scandir($dir);
                foreach ($objects as $object) {
                    if ($object != "." && $object != "..") {
                        if (is_dir($dir . DIRECTORY_SEPARATOR . $object) && !is_link($dir . DIRECTORY_SEPARATOR . $object)) {
                            $removeDir($dir . DIRECTORY_SEPARATOR . $object);
                        } else {
                            unlink($dir . DIRECTORY_SEPARATOR . $object);
                        }
                    }
                }
                rmdir($dir);
            }
        };
        $removeDir($tempExtractDir);
        @unlink($tempZip);
        
        echo "\nOneWeb framework updated successfully!\n";
        exit(0);
    } else {
        echo "Error: Failed to open update zip file.\n";
        @unlink($tempZip);
        exit(1);
    }
}

// 1. Auto-configure VS Code global settings for HTML association
function autoConfigureVSCodeGlobal() {
    $os = strtoupper(substr(PHP_OS, 0, 3));
    $settingsPath = null;
    
    if ($os === 'WIN') {
        $appData = getenv('APPDATA');
        if ($appData) {
            $settingsPath = $appData . '/Code/User/settings.json';
        }
    } elseif ($os === 'MAC' || PHP_OS === 'Darwin') {
        $home = getenv('HOME') ?: ($_SERVER['HOME'] ?? null);
        if ($home) {
            $settingsPath = $home . '/Library/Application Support/Code/User/settings.json';
        }
    } else { // Linux
        $home = getenv('HOME') ?: ($_SERVER['HOME'] ?? null);
        if ($home) {
            $settingsPath = $home . '/.config/Code/User/settings.json';
        }
    }
    
    if ($settingsPath && is_dir(dirname($settingsPath))) {
        $updated = false;
        if (!file_exists($settingsPath)) {
            $defaultSettings = [
                "files.associations" => [
                    "*.one" => "html"
                ]
            ];
            @file_put_contents($settingsPath, json_encode($defaultSettings, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
            $updated = true;
        } else {
            $content = file_get_contents($settingsPath);
            if (strpos($content, '*.one') === false) {
                // Try decoding without comments first
                $cleanContent = preg_replace('~/\*.*?\*/~s', '', $content);
                $cleanContent = preg_replace('~//.*?$~m', '', $cleanContent);
                $decoded = json_decode($cleanContent, true);
                
                if (is_array($decoded)) {
                    if (!isset($decoded['files.associations'])) {
                        $decoded['files.associations'] = [];
                    }
                    $decoded['files.associations']['*.one'] = 'html';
                    @file_put_contents($settingsPath, json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
                    $updated = true;
                } else {
                    // Fallback to simple regex injection to preserve comments
                    if (preg_match('/"files\.associations"\s*:\s*\{/', $content)) {
                        $content = preg_replace('/("files\.associations"\s*:\s*\{)/', "$1\n        \"*.one\": \"html\",", $content, 1);
                        @file_put_contents($settingsPath, $content);
                        $updated = true;
                    } else {
                        $content = preg_replace('/(\{)/', "$1\n  \"files.associations\": {\n    \"*.one\": \"html\"\n  },", $content, 1);
                        @file_put_contents($settingsPath, $content);
                        $updated = true;
                    }
                }
            }
        }
        if ($updated) {
            echo "Auto-configured VS Code global user settings: associated *.one files with HTML.\n";
        }
    }
}
autoConfigureVSCodeGlobal();

// 2. Auto-create local VS Code settings for HTML association
$vscodeDir = $projectRoot . '/.vscode';
if (!is_dir($vscodeDir)) {
    @mkdir($vscodeDir, 0777, true);
}
$vscodeSettingsFile = $vscodeDir . '/settings.json';
if (!file_exists($vscodeSettingsFile)) {
    $vscodeSettings = [
        "files.associations" => [
            "*.one" => "html"
        ]
    ];
    @file_put_contents($vscodeSettingsFile, json_encode($vscodeSettings, JSON_PRETTY_PRINT));
}

// 2. Auto-create public directory and default index.one template
$publicDir = $projectRoot . '/public';
if (!is_dir($publicDir)) {
    @mkdir($publicDir, 0777, true);
}
$indexOne = $publicDir . '/index.one';
if (!file_exists($indexOne)) {
    $defaultIndexContent = <<<EOT
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to OneWeb</title>
</head>
<body>
    <one-container max-width="5xl" class="py-12">
        <div class="text-center">
            <one-badge variant="purple">Successfully Installed</one-badge>
            <h1 class="text-4xl font-extrabold my-4 text-gradient-primary">Welcome to OneWeb!</h1>
            <p class="text-slate-400 text-lg mb-8">Your HTML-first PHP template engine is ready to go.</p>
        </div>
        
        <one-card title="Start Customizing" price="Step 1">
            <p class="mb-4">Open the following file and edit it to change this page:</p>
            <code class="block bg-slate-950 p-4 rounded text-emerald-400 mb-4">public/index.one</code>
            <p>You can create other pages like <code>public/about.one</code> which will resolve to <code>/about</code>.</p>
        </one-card>
    </one-container>
</body>
</html>
EOT;
    @file_put_contents($indexOne, $defaultIndexContent);
}

// 3. Auto-create config.one database configuration
$configPath = $projectRoot . '/config.one';
if (!file_exists($configPath)) {
    $defaultConfigContent = <<<EOT
@db
    driver = "sqlite"
    database = "onescript.sqlite"
@enddb
EOT;
    @file_put_contents($configPath, $defaultConfigContent);
}

// 4. Auto-create onescript.sqlite database file
$sqliteFile = $projectRoot . '/onescript.sqlite';
if (!file_exists($sqliteFile)) {
    @touch($sqliteFile);
}

echo "---------------------------------------------------------\n";
echo " Starting OneScript Local Development Server\n";
echo " URL: http://localhost:8000\n";
echo " Document Root: $projectRoot\n";
echo " Press Ctrl+C to stop the server\n";
echo "---------------------------------------------------------\n\n";

// Start the built-in web server using the bootloader as the router script
$cmd = sprintf('php -S localhost:8000 %s', escapeshellarg($bootScript));
passthru($cmd);
