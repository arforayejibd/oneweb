#!/usr/bin/env php
<?php

/**
 * OneScript CLI Tool & Project Initializer
 */

if (PHP_SAPI !== 'cli') {
    exit("This script can only be run from the command line.\n");
}

$args = $argv;
$command = isset($args[1]) ? strtolower(trim($args[1])) : '';

if ($command !== 'init') {
    echo "OneScript CLI Tool\n";
    echo "Usage:\n";
    echo "  php vendor/bin/onescript init      Initialize a new OneScript project\n\n";
    exit(1);
}

$projectRoot = getcwd();
$packageRoot = dirname(__DIR__);

echo "Initializing OneScript project in: $projectRoot\n\n";

// 1. Create empty public directory
$publicDir = $projectRoot . '/public';
if (!is_dir($publicDir)) {
    if (mkdir($publicDir, 0777, true)) {
        echo "Created directory: public/\n";
    } else {
        echo "Error: Failed to create public/ directory.\n";
    }
} else {
    echo "Skipped: public/ directory (already exists)\n";
}

// 2. Create .vscode directory and settings.json
$vscodeDir = $projectRoot . '/.vscode';
if (!is_dir($vscodeDir)) {
    mkdir($vscodeDir, 0777, true);
}
$vscodeSettingsFile = $vscodeDir . '/settings.json';
if (!file_exists($vscodeSettingsFile)) {
    $vscodeSettings = [
        "files.associations" => [
            "*.one" => "html"
        ]
    ];
    if (file_put_contents($vscodeSettingsFile, json_encode($vscodeSettings, JSON_PRETTY_PRINT))) {
        echo "Created: .vscode/settings.json (HTML association for *.one files)\n";
    } else {
        echo "Error: Failed to create .vscode/settings.json\n";
    }
} else {
    echo "Skipped: .vscode/settings.json (already exists)\n";
}

// Helper to copy files
$copyFile = function ($srcName, $destName) use ($packageRoot, $projectRoot) {
    $srcPath = $packageRoot . '/' . $srcName;
    $destPath = $projectRoot . '/' . $destName;

    if (!file_exists($srcPath)) {
        echo "Warning: Source file $srcName not found in package.\n";
        return;
    }

    if (file_exists($destPath)) {
        echo "Skipped: $destName (already exists)\n";
        return;
    }

    if (copy($srcPath, $destPath)) {
        echo "Created: $destName\n";
    } else {
        echo "Error: Failed to copy $srcName to $destName\n";
    }
};

// 3. Copy configuration files
$copyFile('config.one', 'config.one');
$copyFile('onescript.sqlite', 'onescript.sqlite');
$copyFile('LocalValetDriver.php', 'LocalValetDriver.php');

// 4. Create .htaccess routing to index.php
$htaccessFile = $projectRoot . '/.htaccess';
if (!file_exists($htaccessFile)) {
    $htaccessContent = <<<EOT
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct HTTP access to raw .one, .json, .sqlite, and config files
    <FilesMatch "\.(one|json|sqlite|db|env)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Route all HTTP requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
EOT;

    if (file_put_contents($htaccessFile, $htaccessContent)) {
        echo "Created: .htaccess\n";
    } else {
        echo "Error: Failed to create .htaccess\n";
    }
} else {
    echo "Skipped: .htaccess (already exists)\n";
}

// 5. Create index.php front controller
$indexFile = $projectRoot . '/index.php';
if (!file_exists($indexFile)) {
    $indexContent = <<<EOT
<?php
/**
 * OneScript front controller entry point
 */

// Route static files directly (compatibility with PHP built-in web server)
\$requestUri = parse_url(\$_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH);
\$file = __DIR__ . \$requestUri;
if (\$requestUri !== '/' && file_exists(\$file) && !is_dir(\$file)) {
    return false;
}

// Load Composer autoloader
if (file_exists(__DIR__ . '/vendor/autoload.php')) {
    require_once __DIR__ . '/vendor/autoload.php';
}

// Boot OneScript engine
if (file_exists(__DIR__ . '/vendor/arforayejibd/oneweb/onescript/engine/boot.php')) {
    require_once __DIR__ . '/vendor/arforayejibd/oneweb/onescript/engine/boot.php';
} else {
    // Fallback for local development
    require_once __DIR__ . '/onescript/engine/boot.php';
}
EOT;

    if (file_put_contents($indexFile, $indexContent)) {
        echo "Created: index.php\n";
    } else {
        echo "Error: Failed to create index.php\n";
    }
} else {
    echo "Skipped: index.php (already exists)\n";
}

echo "\nOneScript successfully initialized! You can start the server using:\n";
echo "  php -S localhost:8000\n\n";
echo "Create your first page in public/index.one to get started.\n";
